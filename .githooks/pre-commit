#!/bin/sh
# Refuse to commit anything that looks like a credential.
#
# This repository is public. The .gitignore keeps data/ and settings.ini out,
# but an ignore rule only helps for files you expected; it does nothing about
# a key pasted into a source file or an example. This checks the staged
# content itself, which is the last point where a mistake is still cheap.
#
# Enable with:  git config core.hooksPath .githooks

PATTERN='sk-ant-api[0-9]\{2\}-[A-Za-z0-9_-]\{20,\}\|sk-proj-[A-Za-z0-9_-]\{20,\}\|sk-[A-Za-z0-9]\{40,\}\|AIza[0-9A-Za-z_-]\{30,\}\|[0-9a-f-]\{36\}:fx\|xoxb-[0-9A-Za-z-]\{20,\}\|ghp_[A-Za-z0-9]\{30,\}'

if git diff --cached -U0 | grep -n "^+" | grep -q "$PATTERN"; then
    echo "pre-commit: refused — the staged changes contain something shaped"
    echo "like an API key. This repository is public."
    echo
    git diff --cached -U0 | grep -n "^+" | grep -o "$PATTERN" \
        | sed 's/\(.\{12\}\).*/  \1... (redacted)/' | sort -u
    echo
    echo "Remove it, or commit with --no-verify if it is genuinely a false"
    echo "positive."
    exit 1
fi

# Files that should never be tracked, whatever .gitignore currently says.
if git diff --cached --name-only | grep -qiE '(^|/)(settings\.ini|.*\.env|api_keys?\.(txt|json))$|^data/'; then
    echo "pre-commit: refused — staging a file that holds personal data:"
    git diff --cached --name-only \
        | grep -iE '(^|/)(settings\.ini|.*\.env|api_keys?\.(txt|json))$|^data/' \
        | sed 's/^/  /'
    exit 1
fi

exit 0
